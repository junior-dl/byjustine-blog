---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts=await getCollection("blog");

posts.sort(
(a,b)=>
new Date(b.data.pubDate)-new Date(a.data.pubDate)
);
---

<Layout title="Blog">

<section class="max-w-5xl mx-auto px-6 py-20">

<h1 class="text-6xl font-bold">
Blog
</h1>

<p class="mt-5 text-slate-400">
Thoughts on AI, automation and software.
</p>

<div class="space-y-8 mt-16">

{
posts.map(post=>(

<a
href={`/blog/${post.id}/`}
class="block rounded-3xl border border-white/10 p-8 hover:border-[#ffe4e1] transition-all hover:-translate-y-1">

<h2 class="text-3xl font-bold">
{post.data.title}
</h2>

<p class="mt-4 text-slate-400">
{post.data.description}
</p>

<p class="mt-6 text-sm text-slate-500">
{post.data.pubDate.toDateString()}
</p>

</a>

))
}

</div>

</section>

</Layout>