---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {

const posts=await getCollection("blog");

return posts.map(post=>({
params:{id:post.id.replace(/\.md$/,"")},
props:{post}
}));

}

const {post}=Astro.props;

const {Content}=await render(post);
---

<Layout title={post.data.title}>

<article class="max-w-3xl mx-auto px-6 py-20">

<a
href="/blog"
class="text-[#ffe4e1]">

← Back

</a>

<h1 class="text-6xl font-black mt-8 leading-tight">
{post.data.title}
</h1>

<p class="mt-6 text-slate-500">
{post.data.pubDate.toDateString()}
</p>

<div class="h-px bg-white/10 my-12"></div>

<div class="space-y-6 leading-9 text-lg">

<Content />

</div>

</article>

</Layout>