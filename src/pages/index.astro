---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

posts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() -
    new Date(a.data.pubDate).getTime()
);

const latest = posts.slice(0, 5);
---

<html lang="en">
<head>
    <title>Justine Builds</title>
    <meta charset="UTF-8" />
</head>

<body>

<h1>Justine Builds</h1>

<p>
AI, Automation, n8n, Software Development
</p>

<h2>Latest Posts</h2>

<ul>

{
latest.map(post => (

<li>

<a href={`/blog/${post.id}/`}>

{post.data.title}

</a>

<br/>

<small>{post.data.pubDate.toDateString()}</small>

</li>

))
}

</ul>

</body>

</html>