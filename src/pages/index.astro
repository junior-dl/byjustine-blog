---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

posts.sort(
    (a,b)=>
        new Date(b.data.pubDate)-new Date(a.data.pubDate)
);

const latest=posts.slice(0,3);
---

<Layout title="By Justine">

<section class="max-w-6xl mx-auto px-6 py-24">

<p class="uppercase tracking-[.3em] text-[#ffe4e1] text-sm">
BLOG
</p>

<h1 class="text-7xl font-black mt-6 tracking-tight">
BY JUSTINE.
</h1>

<p class="mt-8 max-w-2xl text-xl text-slate-300 leading-9">
Thoughts, projects, and rabbit holes.
</p>

<p class="mt-2 max-w-full text-xl text-slate-400 leading-9">
Welcome to my little corner of the internet. This is where I share what I'm building, what I'm learning, and the random topics I'm currently obsessed with—from AI and automation to nutrition, productivity, and everything in between.
</p>

<div class="mt-20 flex justify-between items-center">

<h2 class="text-3xl font-semibold">
Latest Posts
</h2>

<a
href="/blog"
class="text-[#ffe4e1]">
View all →
</a>

</div>

<div class="grid gap-8 mt-10">

{
latest.map(post=>(

<a
href={`/blog/${post.id}/`}
class="rounded-3xl border border-white/10 p-8 hover:border-[#ffe4e1] hover:-translate-y-1 transition-all duration-300">

<p class="text-slate-500 text-sm">
{post.data.pubDate.toDateString()}
</p>

<h3 class="text-3xl font-bold mt-3">
{post.data.title}
</h3>

<p class="text-slate-400 mt-4 leading-8">
{post.data.description}
</p>

</a>

))
}

</div>

</section>

</Layout>