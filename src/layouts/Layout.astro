---
import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "Justine Builds" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>{title}</title>
</head>

<body>

<header
class="sticky top-0 z-50 backdrop-blur-md border-b border-white/10 bg-[#0a0505]/80">

<div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-5">

<a
href="/"
class="text-xl font-bold tracking-tight">

JUSTINE
<span class="text-[#ffe4e1]">.</span>

</a>

<nav class="flex gap-8 text-sm">

<a href="/">Home</a>

<a href="/blog">Blog</a>

</nav>

</div>

</header>

<slot />

<footer
class="border-t border-white/10 py-12 mt-24">

<div class="max-w-6xl mx-auto px-6">

<p class="font-bold">
JUSTINE
<span class="text-[#ffe4e1]">.</span>
</p>

<p class="text-slate-500 mt-3">
© 2026 Justine Rose D. Limguis
</p>

</div>

</footer>

</body>
</html>